{
  "name": "codequest",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run build:web && wrangler dev",
    "dev:api": "wrangler dev",
    "dev:web": "npm --workspace @codequest/web run dev",
    "build:web": "npm --workspace @codequest/web run build",
    "build": "npm run build:web",
    "typecheck": "tsc -p tsconfig.json --noEmit && npm --workspace @codequest/web run typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate:course": "node scripts/validate-course.mjs courses/demo",
    "db:migrate": "wrangler d1 migrations apply codequest_local --local",
    "db:reset": "node scripts/reset-local-db.mjs --yes",
    "runtime:upload": "node scripts/upload-runtime-assets.mjs",
    "runtime:upload:remote": "node scripts/upload-runtime-assets.mjs --remote"
  },
  "dependencies": {
    "hono": "^4.6.14",
    "lucide-react": "^1.80.0",
    "ulid": "^2.3.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261102.1",
    "@live-codes/clang-wasm": "^0.3.0",
    "@live-codes/java-wasm": "^0.1.0",
    "@types/react": "^19.0.3",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "@webvirt/c2w": "^0.1.0",
    "playwright-core": "^1.65.1",
    "pyodide": "^314.0.8",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vitest": "^2.1.8",
    "wabt": "^1.0.39",
    "wasi-sh": "^0.11.0",
    "wrangler": "^4.0.0",
    "xterm-pty": "^0.13.0"
  },
  "engines": {
    "node": ">=22"
  }
}
