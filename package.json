{
  "name": "codequest",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "wrangler dev",
    "dev:api": "wrangler dev",
    "dev:web": "npm --workspace @codequest/web run dev",
    "dev:admin": "npm --workspace @codequest/admin run dev",
    "dev:editor": "npm --workspace @codequest/editor run dev",
    "build:web": "npm --workspace @codequest/web run build && node scripts/patch-c2w-workers.mjs",
    "build:admin": "npm --workspace @codequest/admin run build && node scripts/package-admin.mjs",
    "build:admin:embedded": "npm --workspace @codequest/admin run build:embedded",
    "build:editor": "npm --workspace @codequest/editor run build",
    "build:editor:embedded": "npm --workspace @codequest/editor run build:embedded",
    "build": "npm run build:web && npm run build:admin && npm run build:admin:embedded && npm run build:editor && npm run build:editor:embedded && npm run verify:build",
    "verify:build": "node scripts/verify-web-build.mjs",
    "deploy": "wrangler deploy",
    "typecheck": "tsc -p tsconfig.json --noEmit && npm --workspace @codequest/web run typecheck && npm --workspace @codequest/admin run typecheck && npm --workspace @codequest/editor run typecheck",
    "test": "vitest run",
    "test:rpgjs": "vitest run packages/rpgjs-script/tests tests/frontend/rpgjs-workbench.test.ts tests/acceptance/rpgjs-script.test.ts",
    "test:rpgjs:browser": "node scripts/test-rpgjs-worker.mjs",
    "test:watch": "vitest",
    "test:admin": "npm run build:admin && node scripts/test-admin-panel.mjs",
    "test:web": "npm run build:web && node scripts/test-learner-routes.mjs",
    "test:editor": "npm run build:editor:embedded && node scripts/test-editor.mjs",
    "smoke:admin": "node scripts/smoke-admin-api.mjs",
    "validate:course": "node scripts/validate-course.mjs courses/demo",
    "db:migrate": "wrangler d1 migrations apply codequest_local --local",
    "db:migrate:remote": "wrangler d1 migrations apply codequest_local --remote",
    "db:reset": "node scripts/reset-local-db.mjs --yes",
    "runtime:upload": "node scripts/upload-runtime-assets.mjs",
    "runtime:upload:remote": "node scripts/upload-runtime-assets.mjs --remote",
    "container": "node scripts/build-language-container.mjs",
    "container:list": "node scripts/build-language-container.mjs list",
    "container:test": "node scripts/test-language-containers.mjs",
    "test:shell-container": "node scripts/test-shell-container.mjs",
    "test:container-selector": "node scripts/test-container-selector.mjs",
    "test:terminal-vim": "node scripts/test-terminal-vim.mjs",
    "test:runtime-route": "node scripts/test-r2-runtime.mjs",
    "container:c2w": "node scripts/containers/build-c2w.mjs"
  },
  "dependencies": {
    "@canvasengine/presets": "2.6.0",
    "@rpgjs/client": "5.5.1",
    "@rpgjs/script": "5.3.0",
    "@rpgjs/server": "5.4.1",
    "@rpgjs/tiledmap": "5.0.3",
    "canvasengine": "2.6.0",
    "hono": "^4.13.23",
    "lucide-react": "^1.82.0",
    "pixi.js": "8.23.0",
    "ulid": "^2.3.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@canvasengine/compiler": "2.5.0",
    "@cloudflare/workers-types": "^5.20261127.1",
    "@live-codes/clang-wasm": "^0.3.0",
    "@live-codes/java-wasm": "^0.1.0",
    "@rpgjs/vite": "5.0.6",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "@webvirt/c2w": "^0.1.0",
    "playwright-core": "^1.65.1",
    "pyodide": "^314.0.8",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vitest": "^2.1.8",
    "wabt": "^1.0.39",
    "wrangler": "^4.168.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
