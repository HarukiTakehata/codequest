{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "codequest",
	"main": "src/index.ts",
	"compatibility_date": "2026-11-01",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"build": {
		"command": "npm run build",
		"watch_dir": [
			"./src",
			"./apps/web/src",
			"./apps/web/public",
			"./apps/admin/src",
			"./apps/admin/public",
			"./apps/editor/src",
			"./apps/editor/public",
			"./packages"
		]
	},
	"assets": {
		"directory": "./apps/web/dist",
		"binding": "ASSETS",
		"not_found_handling": "single-page-application",
		"run_worker_first": [
			"/",
			"/setup",
			"/login",
			"/password",
			"/courses",
			"/courses/*",
			"/free",
			"/container",
			"/admin",
			"/admin/*",
			"/editor",
			"/editor/*",
			"/api/*",
			"/runtime/*"
		]
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "codequest_local",
			"migrations_dir": "migrations",
			"database_id": "a94815a3-1d33-47ff-80c9-106b7e19441e"
		}
	],
	"r2_buckets": [
		{
			"binding": "COURSE_PACKS",
			"bucket_name": "codequest-course-packs"
		}
	],
	"keep_vars": true,
	"triggers": {
		"crons": [
			"23 * * * *"
		]
	},
	"vars": {
		"ENVIRONMENT": "production",
		"AUTH_MODE": "session",
		"REGISTRATION_ENABLED": "false"
	}
}